generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// 1. DATA MASTER
// ---------------------------------------------------------

// Tabel Admin: Menyimpan data petugas gizi yang bisa akses Dashboard
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabel Siklus Menu: Menyimpan siklus hari ke-1 sampai ke-11
model MenuCycle {
  id          Int        @id // 1 sampai 11
  description String
  menuItems   MenuItem[]
}

// Tabel Item Menu: Katalog makanan. (Menu Include & Exclude digabung)
model MenuItem {
  id          String    @id @default(uuid())
  name        String
  cycleId     Int
  cycle       MenuCycle @relation(fields: [cycleId], references: [id])
  mealTime    MealTime  // Kapan menu ini disajikan (PAGI, SIANG, SORE)
  paketName   String?   // cth: "PAKET A", "PAKET B"
  
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum MealTime {
  PAGI
  SIANG
  SORE
}

// ---------------------------------------------------------
// 2. DATA TRANSAKSIONAL (PEMESANAN)
// ---------------------------------------------------------

// Tabel Pasien: Data yang di-fetch dari API SIMRS setelah login No RM
model Patient {
  id                String   @id @default(uuid())
  rmNumber          String   @unique
  name              String
  dob               DateTime
  phone             String?  // Nomor Telepon (PRD 3.1)
  roomName          String
  roomClass         String   // VIP_A, Kelas_1, dsb (Untuk penentuan kuota porsi)
  allergies         String?
  medicalConditions String?
  
  orders            Order[]
  createdAt         DateTime @default(now())
}

// Tabel Order (Keranjang / Checkout): 1 Order = 1x Transaksi Checkout Pasien
model Order {
  id          String      @id @default(uuid())
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id])
  
  // Data Ruangan & Kelas disimpan (snapshot) di sini 
  // karena pasien Edelweiss bisa pindah kamar (VIP ke Kelas 1 dsb)
  roomNumber  String
  classType   String      // VIP A, Kelas 1, dll (Sangat penting untuk cek kuota)
  
  status      OrderStatus @default(CART)
  notes       String?     // Catatan untuk dapur (1 per order full)
  
  createdAt   DateTime    @default(now())
  checkoutAt  DateTime?
  
  items       OrderItem[]
}

enum OrderStatus {
  CART
  CHECKOUT
}

// Tabel Detail Order (Isi Keranjang): Rincian tiap menu yang dipesan
model OrderItem {
  id             String      @id @default(uuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id])
  
  // Snapshot Data (Struk Mati)
  menuName       String      // Nama makanan yang dicatat permanen saat checkout
  paketName      String?     // Nama paket (jika ada) yang dicatat permanen
  
  // Relasi opsional ke master menu. Jika menu dihapus (hard delete), id ini jadi null, tapi struk tetap aman berkat snapshot di atas.
  menuItemId     String?
  menuItem       MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  
  type           OrderType   // Menentukan ini jatah gratis (INCLUDE) atau Paket Ekstra berbayar (EXCLUDE)
  consumer       Consumer    // Menentukan porsi ini dimakan siapa (PASIEN atau PENDAMPING)
  quantity       Int
  
  servingDate    DateTime    // T+1 untuk Include, hari-H untuk Paket Ekstra
  servingTime    String      // Sesi makan ("SIANG" / "SORE" / "PAGI")
  
  isDelivered    Boolean     @default(false) // Untuk menandai Paket Ekstra sudah diantar (warna hijau di dashboard)
  billingStatus  BillingStat @default(PENDING) // Status pengiriman tagihan ke API Billing RS
}

enum OrderType {
  INCLUDE
  EXCLUDE
}

enum Consumer {
  PASIEN
  PENDAMPING
}

enum BillingStat {
  PENDING
  SYNCED
  FAILED
}

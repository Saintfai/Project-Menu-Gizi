generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MenuCycle {
  id          Int        @id
  description String
  menuItems   MenuItem[]
}

model MenuItem {
  id              String    @id @default(uuid())
  name            String
  cycleId         Int
  mealTime        MealTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  paketName       String?
  description     String?
  karbohidrat     String?
  protein         String?
  nabati          String?
  proteinTambahan String?
  sayur           String?
  bentukMakanan   String?
  cycle           MenuCycle @relation(fields: [cycleId], references: [id])
}

model Patient {
  id        String   @id @default(uuid())
  rmNumber  String   @unique
  name      String
  dob       DateTime
  phone     String?
  roomName  String
  roomClass String
  allergies String?
  createdAt DateTime @default(now())
  address   String?
  orders    Order[]
}

model Order {
  id            String    @id @default(uuid())
  patientId     String
  roomNumber    String
  classType     String
  notes         String?
  createdAt     DateTime  @default(now())
  consumer      Consumer  @default(PASIEN)
  mealTime      MealTime
  menuName      String
  orderCode     String
  paketName     String?
  quantity      Int       @default(1)
  servingDate   DateTime
  type          OrderType @default(INCLUDE)
  bentukMakanan String?
  patient       Patient   @relation(fields: [patientId], references: [id])

  @@index([orderCode])
  @@index([servingDate, mealTime])
  @@index([patientId])
}

model RateLimit {
  key      String   @id
  count    Int      @default(1)
  reset_at DateTime @db.Timestamptz(6)

  @@map("_RateLimit")
}

enum MealTime {
  PAGI
  SIANG
  SORE
}

enum OrderType {
  INCLUDE
  EXCLUDE
}

enum Consumer {
  PASIEN
  PENDAMPING
}
